#!/bin/bash
# Toggle performance mode (for Hyprland 0.55+ Lua config)
# Save as ~/.local/bin/gamemode  (chmod +x)

FLAG=/tmp/gamemode_active

if [ -f "$FLAG" ]; then
    exec mangohud "$@"
    notify-send "🎮 Game Mode OFF" "Visual effects restored"
else
    exec "$@"
    notify-send "🎮 Game Mode ON"
fi

